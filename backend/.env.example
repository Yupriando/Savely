PORT=3000

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon key / publishable key (BUKAN service_role)
SUPABASE_ANON_KEY=

# Zona waktu untuk menentukan "hari ini" (laporan & sisa hari wishlist)
APP_TIMEZONE=Asia/Jakarta

# Origin yang boleh akses API, pisahkan dengan koma. * = semua
CORS_ORIGIN=*
